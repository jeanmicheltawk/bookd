NODE_ENV=development
PORT=3000

# PostgreSQL — this laptop's installed PostgreSQL 17 (port 5432).
# Leave DATABASE_URL empty locally. Render sets DATABASE_URL in production.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bookd_haus
DB_USER=bookd
DB_PASSWORD=bookd_secret

# Used only once by `npm run db:ensure` to create the bookd user + bookd_haus database.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# CORS — comma-separated list in production
CORS_ORIGIN=http://localhost:4200,https://jeanmicheltawk.github.io

# Public site URL used in email links and Whish Pay redirects.
# Whish rejects localhost here — use a public HTTPS URL (or a tunnel) while testing checkout.
APP_URL=http://localhost:4200

# Public API origin Whish calls for payment callbacks. No trailing /api.
# Example (Render): https://bookd-haus.onrender.com
# Local testing: a tunnel to port 3000. Cannot be localhost.
API_PUBLIC_URL=

# Whish Pay — sandbox keys first; swap these for live keys + bookdhaus.com later.
# Docs: https://whish-partners.pages.dev/whish-pay-9z366gc6922w/
WHISH_ENV=sandbox
WHISH_CHANNEL=
WHISH_SECRET=
WHISH_WEBSITE_URL=ille.co
WHISH_USER_AGENT=BookdHaus/1.0 (https://bookdhaus.com; info@bookdhaus.com)

# Transactional email (info@bookdhaus.com)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@bookdhaus.com
SMTP_PASS=
SMTP_FROM=info@bookdhaus.com
NOTIFY_EMAIL=info@bookdhaus.com

# Admin seed (created on first seed)
ADMIN_EMAIL=admin@bookd.com
ADMIN_PASSWORD=bookdadmin
