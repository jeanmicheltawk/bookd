NODE_ENV=development
PORT=3000

# PostgreSQL — local Docker uses the fields below.
# Render sets DATABASE_URL instead; the API prefers that when present.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5433
DB_NAME=bookd_haus
DB_USER=bookd
DB_PASSWORD=bookd_secret

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# CORS — comma-separated list in production
CORS_ORIGIN=http://localhost:4200,https://jeanmicheltawk.github.io

# Admin seed (created on first seed)
ADMIN_EMAIL=admin@bookd.com
ADMIN_PASSWORD=bookdadmin
